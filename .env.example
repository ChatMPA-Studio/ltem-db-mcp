# LTEM Database MCP Server — Environment Variables
# Copy to .env and fill in credentials. Never commit .env to version control.

# --- Database (individual vars) ---
LTEM_DB_HOST=ecological-monitoring.co1yqscc6dj3.us-east-1.rds.amazonaws.com
LTEM_DB_PORT=3306
LTEM_DB_USER=mcp_ltem_ro
LTEM_DB_PASSWORD=CHANGEME
LTEM_DB_NAME=ecological_monitoring

# --- Or use a single DATABASE_URL (takes precedence over individual vars) ---
# DATABASE_URL=mysql://mcp_ltem_ro:PASSWORD@host:3306/ecological_monitoring

# --- TLS / SSL (optional; OFF by default) ---
# The RDS instance supports TLS (have_ssl=YES) but does not require it.
# Recommended once the DB is on the public internet: set DB_SSL=true and point
# DB_SSL_CA at Amazon's RDS CA bundle to encrypt + verify the server cert.
#   curl -o /app/global-bundle.pem https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# DB_SSL=false
# DB_SSL_CA=/app/global-bundle.pem

# --- Connection Pool (optional; defaults shown) ---
# DB_POOL_MIN=1         # idle connections kept open at all times
# DB_POOL_MAX_CACHED=5  # idle connections kept cached for reuse
# DB_POOL_MAX=10         # hard cap; requests beyond this block until one frees up

# --- HTTP Server (Docker) ---
PORT=8000
MCP_BASE_PATH=/mcp
LOG_LEVEL=INFO

# --- Docker Compose ---
# HOST_PORT: the port exposed on the host (default 8001, bound to 127.0.0.1)
HOST_PORT=8001

# --- Auth (per-investigator API keys, validated against DynamoDB) ---
# AUTH_ENABLED=true makes every HTTP request require
# `Authorization: Bearer <key>` — internal callers included. Turn it on only
# once the DynamoDB table exists AND every caller (orchestrator included) has
# been issued a key with the "ltem" scope, or the server answers 401 to
# everything.
# AUTH_ENABLED=false
# AUTH_DYNAMODB_TABLE=chatmpa-mcp-auth
# AUTH_AWS_REGION=us-west-2
# AUTH_CACHE_TTL_SECONDS=60  # how long a key lookup (hit or miss) is cached
# AUTH_CACHE_MAX_ENTRIES=1000  # cache size cap; when full, the oldest entry is evicted
