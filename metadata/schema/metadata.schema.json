{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cbmc.org/schemas/mcp-metadata.schema.json",
  "title": "MCP Server Metadata Schema",
  "description": "JSON Schema for MCP server metadata template",
  "type": "object",
  "required": ["package", "dataset", "schema", "endpoints"],
  "properties": {
    "package": {
      "type": "object",
      "required": ["name", "version", "description", "license"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Package name (lowercase, hyphens allowed)"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semantic version (X.Y.Z)"
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500
        },
        "maintainer": {
          "type": "object",
          "properties": {
            "name": {"type": "string"},
            "email": {"type": "string", "format": "email"},
            "organization": {"type": "string"}
          }
        },
        "license": {
          "type": "string",
          "enum": ["MIT", "Apache-2.0", "GPL-3.0", "BSD-3-Clause", "CC-BY-4.0", "CC-BY-NC-4.0"]
        },
        "repository": {
          "type": "object",
          "properties": {
            "type": {"type": "string", "enum": ["git", "svn", "hg"]},
            "url": {"type": "string", "format": "uri"}
          }
        },
        "runtime": {
          "type": "object",
          "properties": {
            "python_version": {"type": "string"},
            "dependencies": {"type": "array", "items": {"type": "string"}},
            "docker_image": {"type": "string"},
            "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
            "base_path": {"type": "string", "pattern": "^/.*"}
          }
        }
      }
    },
    "dataset": {
      "type": "object",
      "required": ["title", "description"],
      "properties": {
        "title": {"type": "string"},
        "description": {"type": "string", "minLength": 50},
        "keywords": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 3
        },
        "spatial_coverage": {
          "type": "object",
          "properties": {
            "description": {"type": "string"},
            "regions": {"type": "array", "items": {"type": "string"}},
            "bounding_box": {
              "type": "object",
              "properties": {
                "north": {"type": "number"},
                "south": {"type": "number"},
                "east": {"type": "number"},
                "west": {"type": "number"}
              }
            }
          }
        },
        "temporal_coverage": {
          "type": "object",
          "properties": {
            "start": {"type": "string", "format": "date"},
            "end": {"type": "string", "format": "date"},
            "frequency": {"type": "string"},
            "total_years": {"type": "integer", "minimum": 1}
          }
        },
        "publisher": {
          "type": "object",
          "properties": {
            "name": {"type": "string"},
            "url": {"type": "string", "format": "uri"}
          }
        },
        "language": {"type": "string", "pattern": "^[a-z]{2}$"},
        "license": {"type": "string"}
      }
    },
    "schema": {
      "type": "object",
      "properties": {
        "database": {
          "type": "object",
          "properties": {
            "type": {"type": "string", "enum": ["MySQL", "PostgreSQL", "MariaDB", "SQLite"]},
            "version": {"type": "string"},
            "name": {"type": "string"},
            "tables": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {"type": "string"},
                  "description": {"type": "string"},
                  "row_count": {"type": "integer"},
                  "primary_key": {"type": "array", "items": {"type": "string"}},
                  "indexes": {"type": "array", "items": {"type": "string"}}
                }
              }
            }
          }
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string"},
              "description": {"type": "string"},
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {"type": "string"},
                    "type": {"type": "string"},
                    "description": {"type": "string"},
                    "required": {"type": "boolean"},
                    "units": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "endpoints": {
      "type": "object",
      "required": ["tools", "skills", "resources"],
      "properties": {
        "tools": {
          "type": "object",
          "properties": {
            "count": {"type": "integer", "minimum": 0},
            "categories": {"type": "array", "items": {"type": "string"}}
          }
        },
        "skills": {
          "type": "object",
          "properties": {
            "count": {"type": "integer", "minimum": 0},
            "available": {"type": "array", "items": {"type": "string"}}
          }
        },
        "resources": {
          "type": "object",
          "properties": {
            "count": {"type": "integer", "minimum": 0},
            "available": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_systems": {"type": "array"},
        "extraction": {"type": "object"},
        "processing": {"type": "object"},
        "quality": {"type": "object"}
      }
    },
    "analytics": {
      "type": "object",
      "properties": {
        "statistical_methods": {"type": "array", "items": {"type": "string"}},
        "aggregation_rules": {"type": "object"}
      }
    },
    "generated": {
      "type": "object",
      "properties": {
        "timestamp": {"type": "string", "format": "date-time"},
        "generator": {"type": "string"},
        "version": {"type": "string"}
      }
    }
  }
}
