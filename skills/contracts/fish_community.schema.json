{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cbmc.org/schemas/skills/fish_community.schema.json",
  "title": "Fish Community Analysis Input",
  "description": "Analyze species composition and diversity",
  "type": "object",
  "properties": {
    "region": {
      "type": ["string", "null"],
      "description": "Region to analyze"
    },
    "year": {
      "type": ["integer", "null"],
      "description": "Year to analyze (null = all years)",
      "minimum": 1999,
      "maximum": 2024
    },
    "depth": {
      "type": ["string", "null"],
      "description": "Depth category",
      "enum": [null, "Shallow", "Deep"]
    },
    "top_n": {
      "type": "integer",
      "description": "Number of top species to include",
      "minimum": 5,
      "maximum": 50,
      "default": 15
    }
  },
  "additionalProperties": false
}
